{
  "name": "mangopay4/php-sdk",
  "description": "PHP SDK for MANGOPAY",
  "minimum-stability": "stable",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-openssl": "*",
    "psr/log": "^2.0|^3.0",
    "ext-json": "*",
    "ext-fileinfo": "*"
  },
  "autoload": {
    "psr-4": {
      "MangoPay\\": "MangoPay"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MangoPay\\Tests\\": "tests"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "friendsofphp/php-cs-fixer": "^3.0"
  }
}
